{
  "name": "server.giraycoskun.dev-astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "watchlist:dev": "wrangler dev --config workers/letterboxd/wrangler.jsonc --test-scheduled",
    "watchlist:check": "tsc -p workers/letterboxd/tsconfig.json && node --experimental-strip-types --test workers/letterboxd/watchlist.test.mjs",
    "watchlist:kv:create": "wrangler kv namespace create WATCHLIST --config workers/letterboxd/wrangler.jsonc",
    "watchlist:deploy": "wrangler deploy --config workers/letterboxd/wrangler.jsonc",
    "hardcover:check": "tsc -p workers/hardcover/tsconfig.json",
    "hardcover:dev": "wrangler dev --config workers/hardcover/wrangler.jsonc --test-scheduled",
    "hardcover:kv:create": "wrangler kv namespace create HARDCOVER_BOOKS --config workers/hardcover/wrangler.jsonc",
    "hardcover:deploy": "wrangler deploy --config workers/hardcover/wrangler.jsonc"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/react": "^7.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "wrangler": "4.152.0"
  }
}
